---
import type { WorkflowFlow } from "../data/workflowFlows";
interface Props extends WorkflowFlow {}
const { caption, nodes, steps } = Astro.props;
---
<figure class="request-flow not-content" data-steps={JSON.stringify(steps)} aria-label={caption}>
  <figcaption>{caption}</figcaption>
  <ol class="flow-nodes" aria-label="Participants in the flow">
    {nodes.map((node, index) => <li class="flow-node" data-active={steps[0].active.includes(index) ? 'true' : 'false'}>
      <span class="node-number" aria-hidden="true">0{index + 1}</span>
      <strong>{node.name}</strong><span class="node-detail">{node.detail}</span>
      {index < nodes.length - 1 && <span class="flow-connector" aria-hidden="true" data-active={steps[0].links.includes(index) ? 'true' : 'false'}><span class="flow-packet"></span></span>}
    </li>)}
  </ol>
  <div class="flow-explanation">
    <span class="flow-step-count">Step 1 of {steps.length}</span>
    <p class="flow-step-title">{steps[0].title}</p>
    <p class="flow-step-description">{steps[0].text}</p>
  </div>
  <div class="flow-controls" hidden>
    <button type="button" data-action="previous" aria-label="Previous flow step" disabled>← Back</button>
    <button type="button" data-action="next" aria-label="Next flow step">Next →</button>
  </div>
  <noscript><ol>{steps.map((step) => <li><strong>{step.title}.</strong> {step.text}</li>)}</ol></noscript>
  <p class="flow-announcement" role="status" aria-live="polite"></p>
</figure>
<script>
  type Step = { title: string; text: string; active: number[]; links: number[]; reverse?: boolean };
  document.querySelectorAll<HTMLElement>('.request-flow').forEach((flow) => {
    const steps: Step[] = JSON.parse(flow.dataset.steps!);
    const nodes = flow.querySelectorAll<HTMLElement>('.flow-node');
    const links = flow.querySelectorAll<HTMLElement>('.flow-connector');
    const previous = flow.querySelector<HTMLButtonElement>('[data-action="previous"]')!;
    const next = flow.querySelector<HTMLButtonElement>('[data-action="next"]')!;
    const announcement = flow.querySelector<HTMLElement>('.flow-announcement')!;
    let current = 0;
    const render = (announce = false) => {
      flow.dataset.animating = 'false';
      const step = steps[current];
      flow.dataset.reverse = String(Boolean(step.reverse));
      nodes.forEach((node, index) => { node.dataset.active = String(step.active.includes(index)); });
      links.forEach((link, index) => { link.dataset.active = String(step.links.includes(index)); });
      flow.querySelector('.flow-step-count')!.textContent = `Step ${current + 1} of ${steps.length}`;
      flow.querySelector('.flow-step-title')!.textContent = step.title;
      flow.querySelector('.flow-step-description')!.textContent = step.text;
      previous.disabled = current === 0;
      next.disabled = current === steps.length - 1;
      // Restart a single packet animation for this step, without advancing the flow.
      void flow.offsetWidth;
      flow.dataset.animating = 'true';
      if (announce) announcement.textContent = `Step ${current + 1} of ${steps.length}. ${step.title}. ${step.text}`;
    };
    previous.addEventListener('click', () => { current = Math.max(0, current - 1); render(true); });
    next.addEventListener('click', () => { current = Math.min(steps.length - 1, current + 1); render(true); });
    flow.querySelector<HTMLElement>('.flow-controls')!.hidden = false;
  });
</script>
<style>
  .request-flow { margin: var(--fm-space-8) 0; padding: var(--fm-space-6); border: 1px solid var(--fm-line); border-radius: var(--fm-radius-lg); background: var(--fm-surface); color: var(--fm-ink); }
  figcaption { font-size: var(--fm-text-sm); font-weight: 600; margin-bottom: var(--fm-space-6); }
  .flow-nodes { list-style: none; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--fm-space-6); margin: 0; padding: 0; }
  .flow-node { position: relative; display: flex; flex-direction: column; gap: var(--fm-space-2); padding: var(--fm-space-4) var(--fm-space-3); border: 1px solid var(--fm-line); border-radius: var(--fm-radius-md); background: var(--fm-paper); min-width: 0; }
  .flow-node[data-active='true'] { border-color: var(--fm-ink); box-shadow: inset 0 0 0 1px var(--fm-ink); }
  .node-number { font: var(--fm-text-xs)/1 var(--fm-font-mono); color: var(--fm-muted); }
  .flow-node strong { font-size: var(--fm-text-sm); font-weight: 600; }
  .node-detail { color: var(--fm-muted); font-size: var(--fm-text-xs); line-height: 1.5; }
  .flow-connector { position: absolute; left: calc(100% + 1px); top: 50%; width: var(--fm-space-6); height: 1px; background: var(--fm-line); }
  .flow-connector::after { content: ''; position: absolute; right: 3px; top: -3px; width: 6px; height: 6px; border-right: 1px solid var(--fm-muted); border-top: 1px solid var(--fm-muted); transform: rotate(45deg); }
  .flow-packet { position: absolute; top: -3px; left: 0; width: 7px; height: 7px; border-radius: 50%; background: var(--fm-ink); opacity: 0; }
  .flow-connector[data-active='true'] { background: var(--fm-muted); }
  .flow-connector[data-active='true'] .flow-packet { opacity: 1; }
  [data-animating='true'] .flow-connector[data-active='true'] .flow-packet { animation: transfer-x 700ms ease-in-out 1 both; }
  [data-reverse='true'] .flow-connector::after { right: auto; left: 3px; transform: rotate(225deg); }
  [data-reverse='true'] .flow-packet { animation-direction: reverse !important; }
  .flow-explanation { margin-top: var(--fm-space-6); padding-top: var(--fm-space-6); border-top: 1px solid var(--fm-line); min-height: 9rem; }
  .flow-step-count { color: var(--fm-muted); font: var(--fm-text-xs)/1.5 var(--fm-font-mono); }
  .flow-step-title { font-size: var(--fm-text-body); font-weight: 600; margin: var(--fm-space-2) 0; }
  .flow-step-description { color: var(--fm-muted); font-size: var(--fm-text-sm); line-height: var(--fm-leading); margin: 0; }
  .flow-controls { display: flex; justify-content: space-between; gap: var(--fm-space-2); margin-top: var(--fm-space-4); }
  .flow-controls[hidden] { display: none; }
  button { min-height: 44px; padding: var(--fm-space-2) var(--fm-space-3); color: var(--fm-ink); border: 1px solid var(--fm-line); background: var(--fm-paper); border-radius: var(--fm-radius-sm); font: 500 var(--fm-text-sm)/1.4 var(--sl-font); cursor: pointer; }
  button:hover:not(:disabled) { border-color: var(--fm-ink); }
  button:disabled { color: var(--fm-muted); cursor: default; }
  .flow-announcement { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  @keyframes transfer-x { from { transform: translateX(0); } to { transform: translateX(calc(var(--fm-space-6) - 7px)); } }
  @keyframes transfer-y { from { transform: translateY(0); } to { transform: translateY(calc(var(--fm-space-6) - 7px)); } }
  @media (max-width: 620px) {
    .request-flow { padding: var(--fm-space-4); }
    .flow-nodes { grid-template-columns: minmax(0, 1fr); }
    .flow-node { display: grid; grid-template-columns: 1.5rem 1fr; align-items: baseline; padding: var(--fm-space-3); gap: var(--fm-space-1) var(--fm-space-2); }
    .node-detail { grid-column: 2; }
    .flow-connector { top: calc(100% + 1px); left: 50%; width: 1px; height: var(--fm-space-6); }
    .flow-connector::after { top: auto; right: -3px; bottom: 3px; transform: rotate(135deg); }
    [data-reverse='true'] .flow-connector::after { top: 3px; bottom: auto; left: -3px; transform: rotate(315deg); }
    .flow-packet { top: 0; left: -3px; }
    [data-animating='true'] .flow-connector[data-active='true'] .flow-packet { animation-name: transfer-y; }
    .flow-explanation { min-height: 12rem; }
    button { font-size: var(--fm-text-xs); }
  }
  @media (prefers-reduced-motion: reduce) { .request-flow .flow-packet { animation: none !important; } }
</style>
