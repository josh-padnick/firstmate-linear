{
  "name": "fm-linear",
  "private": true,
  "type": "module",
  "workspaces": [
    "docs"
  ],
  "scripts": {
    "docs:dev": "bun run --cwd docs dev",
    "docs:check": "bun run --cwd docs check",
    "docs:build": "bun run --cwd docs build",
    "docs:preview": "bun run --cwd docs preview",
    "check": "bun run scripts/build.ts && bun run lint && bun run typecheck && bun test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun run scripts/build.ts && bun test",
    "build": "bun run scripts/build.ts --compile",
    "fm-linear": "bun run src/cli.ts"
  },
  "packageManager": "bun@1.4.2",
  "dependencies": {
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/bun": "1.4.2",
    "typescript": "7.0.2"
  }
}
